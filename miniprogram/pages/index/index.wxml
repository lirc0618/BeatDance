<view class="container">
  <view class="hero" wx:if="{{!insight}}">
    <view class="badge">BeatDance · AI ACTION SEARCH</view>
    <view class="hero-title">
      <view>刷到抖舞来对拍，</view>
      <view class="accent">全场卡点不带歪</view>
    </view>
    <view class="hero-copy">不用知道动作名。暂停、模仿一次，AI 会找到你真正卡住的地方，再换一种更适合你的角度讲明白。</view>
    <view class="flow-strip">
      <view><text>01</text>停住画面</view><text>→</text>
      <view><text>02</text>模仿一次</view><text>→</text>
      <view><text>03</text>找到拆法</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card"><view class="card-copy">正在读取暂停点和动作上下文…</view></view>
  <view wx:if="{{error}}" class="card"><view class="warning">{{error}}</view><button class="ghost" bindtap="loadActions">重试</button></view>

  <block wx:if="{{!insight}}">
    <view class="section-head">
      <view class="step-index">01</view>
      <view><view class="section-title">先刷一个想学的</view><view class="section-copy">听着原声播放，看到不会的地方就暂停。</view></view>
    </view>
    <block wx:for="{{actions}}" wx:key="id">
      <view class="feed-card">
        <view class="feed-visual">
          <video wx:if="{{item.reference_ready}}" class="feed-video" src="{{item.feed_video_full_url}}" controls object-fit="contain" data-id="{{item.id}}" bindtimeupdate="trackFeedTime" bindpause="pauseFeed"></video>
          <view class="feed-segment">{{item.segment_label}}</view>
          <view class="pause">Ⅱ</view>
        </view>
        <view class="feed-body">
          <view class="feed-meta"><view class="creator">{{item.creator}}</view><text>0{{index + 1}}</text></view>
          <view class="search-type">{{item.skill_focus}}</view>
          <view class="feed-title">{{item.feed_caption || item.name}}</view>
          <view class="card-copy">{{item.description}}</view>
          <view class="pause-hint"><view class="pause-dot"></view>播放，停在没看懂的那一帧</view>
          <button class="feed-cta" disabled="{{!item.reference_ready || !item.pauseReady}}" data-id="{{item.id}}" bindtap="chooseAction">{{item.reference_ready ? (item.pauseCopy || '播放视频，停在没看懂处') : '待配置参考片段'}}</button>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{insight}}" class="card">
    <view class="section-label cyan">定格 {{insight.timestamp_seconds}} 秒 · {{insight.phase}}</view>
    <video class="video-preview" src="{{selectedAction.feed_video_full_url}}" initial-time="{{insight.timestamp_seconds}}" controls object-fit="contain"></video>
    <view class="creator card-gap">{{insight.observed_motion}}</view>
    <view class="card-title card-gap">{{insight.likely_stuck_at}}</view>
    <view class="card-copy">{{insight.watch_for}}</view>
    <view class="search-title">
      <view class="section-label cyan">{{insight.has_local_tutorials ? 'AI 即时拆解 · 取自当前视频' : '搜索方向 · 不是当前视频生成'}}</view>
      <view class="card-title">{{insight.has_local_tutorials ? '同源慢放、镜像和局部' : '先看该找哪种视角'}}</view>
    </view>
    <block wx:for="{{insight.search_results}}" wx:key="id">
      <view class="search-card">
        <video wx:if="{{item.local_asset}}" class="tutorial-video" src="{{item.url}}" controls object-fit="cover"></video>
        <view class="search-type">{{item.view_type}} · {{item.clip_seconds}}</view>
        <view class="card-title">{{item.title}}</view>
        <view wx:if="{{!item.local_asset}}" class="search-open" data-url="{{item.url}}" bindtap="copySearch">打开原视频 →</view>
      </view>
    </block>
    <button class="related-cta" bindtap="searchRelated">搜外部相关视频 ↗</button>
    <button class="primary" bindtap="startPractice">拍一次，看我具体卡哪儿</button>
    <button class="ghost" bindtap="backToFeed">回到 Feed 重新定格</button>
  </view>

  <view class="hint">AI 会回看暂停点前后几秒；再拍一段 3–8 秒模仿，就能找到你具体卡哪儿。</view>

  <view wx:if="{{relatedOpen}}" class="related-mask" bindtap="closeRelated">
    <view class="related-sheet" catchtap="noop">
      <view class="related-head">
        <view><view class="section-label cyan">RELATED VIDEO SEARCH</view><view class="card-title">外面有没有人讲明白？</view></view>
        <view class="related-close" bindtap="closeRelated">×</view>
      </view>
      <view class="related-status">{{relatedStatus}}</view>
      <view wx:if="{{relatedQuery}}" class="related-query">这次搜：{{relatedQuery}}</view>
      <block wx:for="{{relatedVideos}}" wx:key="id">
        <view class="related-video">
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill"></image>
          <view class="related-video-copy">
            <view class="search-type">抖音 · {{item.like_count}} 赞</view>
            <view class="related-video-title">{{item.title}}</view>
            <view class="creator">{{item.creator}}</view>
            <view class="search-open" data-url="{{item.url}}" bindtap="copyExternal">复制原视频链接 →</view>
          </view>
        </view>
      </block>
      <view wx:if="{{!relatedLoading && !relatedVideos.length}}" class="related-empty">没有直接返回卡片，下面的精准搜索入口照样能用。</view>
      <block wx:for="{{relatedLaunches}}" wx:key="platform">
        <button class="related-launch" data-url="{{item.url}}" bindtap="copyExternal">{{item.label}}</button>
      </block>
      <view class="related-note">微信内不能直接打开外部网页，点击后复制链接。</view>
    </view>
  </view>
</view>
