<view class="container" wx:if="{{result}}">
  <view class="hero">
    <view class="badge">{{resultBadge}}</view>
    <view class="big-result">{{result.diagnosis.primary_error}}</view>
    <view class="feedback">{{result.diagnosis.vlm_summary || result.diagnosis.priority_feedback}}</view>
  </view>

  <view wx:if="{{comparisonVideoUrl}}" class="card">
    <view class="section-label">整段分析 {{result.duration_seconds}} 秒 · {{result.analyzed_frame_count}} 帧 · 红色是卡点</view>
    <video class="video-preview" src="{{comparisonVideoUrl}}" controls loop object-fit="contain"></video>
  </view>

  <image wx:if="{{comparisonUrl}}" class="comparison" src="{{comparisonUrl}}" mode="widthFix"></image>

  <view class="metric-row">
    <block wx:for="{{displayMetrics}}" wx:key="kind">
      <view class="metric">
        <view class="metric-label">{{metricLabels[item.kind]}} · {{item.body_part}}</view>
        <view class="metric-value">{{item.human_value}}</view>
      </view>
    </block>
  </view>

  <view class="card card-gap">
    <view class="section-label">只练这一件事</view>
    <view class="card-title">{{result.diagnosis.drill}}</view>
  </view>

  <view class="search-title">
    <view class="section-label cyan">还没懂？换个视角</view>
    <view class="card-title">三条对症拆法</view>
  </view>

  <block wx:for="{{result.diagnosis.search_results}}" wx:key="id">
    <view class="search-card">
      <video wx:if="{{item.local_asset}}" class="tutorial-video" src="{{item.url}}" controls object-fit="cover"></video>
      <view class="search-type">{{item.view_type}}<text wx:if="{{item.clip_seconds}}"> · {{item.clip_seconds}}</text></view>
      <view class="card-title">{{item.title}}</view>
      <view class="why">{{item.why_matched}}</view>
      <view wx:if="{{!item.local_asset}}" class="search-open" data-url="{{item.url}}" bindtap="openTutorial">打开原视频 ›</view>
    </view>
  </block>

  <view class="card" wx:if="{{result.improvement}}"><view class="card-title">{{result.improvement.message}}</view></view>
  <block wx:for="{{result.warnings}}" wx:key="*this"><view class="warning">小提醒：{{item}}</view></block>

  <button class="primary" bindtap="retry">{{retryText}}</button>
  <button class="ghost" bindtap="restart">回到 Feed 换一招</button>
</view>
