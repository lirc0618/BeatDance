page {
  background-color: #090a08;
  color: #f3f3e9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.container { padding: 30rpx 30rpx 72rpx; }

.hero {
  padding: 38rpx 0 32rpx;
  border-bottom: 2rpx solid #2b2e26;
}

.badge {
  color: #d9ff43;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 62rpx;
  line-height: .96;
  font-weight: 900;
  letter-spacing: -7rpx;
}

.hero-title .accent { color: #d9ff43; }

.small-title { font-size: 68rpx; }

.hero-copy {
  margin-top: 24rpx;
  color: #b7b9ae;
  font-size: 24rpx;
  line-height: 1.6;
}

.flow-strip {
  margin-top: 30rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #2b2e26;
  border-bottom: 2rpx solid #2b2e26;
  font-size: 20rpx;
  font-weight: 700;
}

.flow-strip view { display: flex; flex-direction: column; gap: 8rpx; }
.flow-strip view text { color: #92958a; font-size: 16rpx; letter-spacing: 2rpx; }
.flow-strip > text { color: #505348; }

.section-head {
  padding: 42rpx 0 24rpx;
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.step-index {
  padding-top: 8rpx;
  color: #d9ff43;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.section-title { font-size: 48rpx; font-weight: 900; letter-spacing: -2rpx; }
.section-copy { margin-top: 8rpx; color: #92958a; font-size: 23rpx; }

.card {
  margin-bottom: 22rpx;
  padding: 32rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 32rpx;
  background: #11120f;
}

.card-gap { margin-top: 24rpx; }
.card-title { font-size: 35rpx; font-weight: 850; line-height: 1.4; }
.card-copy { margin-top: 15rpx; color: #92958a; font-size: 24rpx; line-height: 1.65; }
.card-meta { margin-top: 20rpx; font-size: 23rpx; font-weight: 700; }

.primary,
.ghost {
  width: 100%;
  min-height: 98rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
  font-weight: 850;
}

.primary { color: #111208; background: #d9ff43; }
.primary[disabled] { color: #686b62; background: #242620; }
.ghost { color: #f3f3e9; background: transparent; border: 2rpx solid #2b2e26; }

.hint {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #2b2e26;
  color: #797c72;
  font-size: 21rpx;
  line-height: 1.7;
}

.feed-card {
  margin-bottom: 28rpx;
  overflow: hidden;
  border: 2rpx solid #2b2e26;
  border-radius: 34rpx;
  background: #11120f;
}

.feed-visual {
  height: 420rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: #20221c;
}

.feed-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #000;
}

.feed-segment {
  z-index: 2;
  max-width: 75%;
  padding: 10rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,.18);
  border-radius: 14rpx;
  color: #fff;
  background: rgba(7,8,7,.7);
  font-size: 19rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pause {
  position: absolute;
  z-index: 2;
  top: 20rpx;
  right: 20rpx;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,.2);
  border-radius: 18rpx;
  background: rgba(7,8,7,.65);
  font-weight: 900;
}

.feed-body { padding: 32rpx; }

.feed-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.feed-meta > text { color: #45483e; font-size: 19rpx; }
.creator { color: #92958a; font-size: 20rpx; line-height: 1.45; }

.feed-title {
  margin-top: 25rpx;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 850;
  letter-spacing: -1rpx;
}

.pause-hint {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #b6b9ac;
  font-size: 20rpx;
}

.pause-dot {
  width: 9rpx;
  height: 9rpx;
  border: 4rpx solid #d9ff43;
  border-radius: 50%;
}

.feed-cta {
  margin-top: 22rpx;
  border-radius: 22rpx;
  color: #111208;
  background: #d9ff43;
  font-weight: 900;
}

.feed-cta[disabled] { color: #696c63; background: #242620; }

.focus-row {
  margin-bottom: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.focus-chip {
  padding: 19rpx 16rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 16rpx;
  color: #b7baae;
  background: transparent;
  font-size: 23rpx;
  text-align: center;
}

.focus-chip.active { color: #111208; border-color: #d9ff43; background: #d9ff43; font-weight: 800; }

.video-preview { width: 100%; border-radius: 28rpx; background: #000; }
.upload-hint { margin-top: 28rpx; }

.metric-row { margin-top: 20rpx; display: grid; grid-template-columns: 1fr; gap: 14rpx; }

.metric {
  padding: 24rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 22rpx;
  background: #171914;
}

.metric-label { color: #92958a; font-size: 21rpx; }
.metric-value { margin-top: 10rpx; font-size: 29rpx; font-weight: 850; }

.section-label { margin-bottom: 10rpx; color: #92958a; font-size: 20rpx; }
.cyan { color: #d9ff43; }

.big-result {
  margin: 28rpx 0 20rpx;
  font-size: 65rpx;
  line-height: 1.06;
  font-weight: 900;
  letter-spacing: -4rpx;
}

.feedback { color: #c8cabf; font-size: 31rpx; line-height: 1.72; }
.comparison { width: 100%; margin-top: 20rpx; border-radius: 28rpx; }
.warning { margin-top: 14rpx; color: #e9c56c; font-size: 23rpx; }

.search-title { margin: 50rpx 0 22rpx; }
.query { margin-top: 14rpx; color: #777a70; font-size: 20rpx; line-height: 1.5; }

.search-card {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 26rpx;
  background: #171914;
}

.tutorial-video {
  width: 100%;
  height: 620rpx;
  margin-bottom: 22rpx;
  border-radius: 18rpx;
  background: #000;
}

.search-type { margin-bottom: 12rpx; color: #d9ff43; font-size: 20rpx; }
.why { margin-top: 14rpx; color: #777a70; font-size: 20rpx; line-height: 1.5; }
.search-open { margin-top: 20rpx; color: #d9ff43; font-size: 21rpx; }

.related-cta {
  width: 100%;
  min-height: 86rpx;
  margin: 12rpx 0 4rpx;
  border: 2rpx solid #d9ff43;
  border-radius: 20rpx;
  color: #d9ff43;
  background: rgba(217,255,67,.06);
  font-size: 23rpx;
  font-weight: 850;
}

.related-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  padding: 40rpx 24rpx;
  display: flex;
  align-items: flex-end;
  background: rgba(4,5,3,.78);
}

.related-sheet {
  width: 100%;
  max-height: 84vh;
  overflow-y: auto;
  padding: 32rpx;
  border: 2rpx solid #3c4035;
  border-radius: 34rpx;
  background: #11130f;
}

.related-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.related-close {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #2b2e26;
  border-radius: 50%;
  font-size: 40rpx;
}

.related-status { margin-top: 30rpx; color: #c5c8bc; font-size: 23rpx; }

.related-query {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 16rpx;
  color: #92958a;
  background: #0b0c09;
  font-size: 19rpx;
  line-height: 1.5;
}

.related-video {
  margin-top: 18rpx;
  overflow: hidden;
  display: flex;
  border: 2rpx solid #2b2e26;
  border-radius: 22rpx;
  background: #171914;
}

.related-video image { width: 200rpx; min-height: 240rpx; flex: none; }
.related-video-copy { min-width: 0; padding: 22rpx; }
.related-video-title { font-size: 26rpx; font-weight: 800; line-height: 1.45; }
.related-empty { padding: 35rpx 12rpx; color: #92958a; font-size: 22rpx; text-align: center; }

.related-launch {
  margin-top: 14rpx;
  border: 2rpx solid #2b2e26;
  border-radius: 18rpx;
  color: #f3f3e9;
  background: #171914;
  font-size: 22rpx;
  font-weight: 800;
}

.related-note { margin-top: 18rpx; color: #66695f; font-size: 18rpx; line-height: 1.5; }
